{
  "name": "indesign-ai-plugin",
  "version": "0.4.0",
  "private": true,
  "description": "InDesign UXP AI panel — layout assist and vector-table recovery",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "tsx --test plugin/src/**/*.test.ts plugin/src/**/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
